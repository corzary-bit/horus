	column 'Semana índice'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b79cd28a-194b-58d1-8158-f50fe9c2a0d7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Semana índice]

		annotation SummarizationSetBy = Automatic

	partition 'Semanas SNP' = calculated
		mode: import
		source =
				-- Una fila por semana relevada en SNP (Fecha = lunes, normalizado en silver).
				-- "Semana filtro" llama "Semana actual" a la última semana con datos de esta fuente.
				VAR _fechas = FILTER ( DISTINCT ( 'Precios SNP'[Fecha] ), NOT ISBLANK ( 'Precios SNP'[Fecha] ) )
				VAR _ult = MAXX ( _fechas, 'Precios SNP'[Fecha] )
				VAR _ultIdx = INT ( ( _ult - WEEKDAY ( _ult, 3 ) - DATE ( 2018, 1, 1 ) ) / 7 )
				VAR _semanas = ADDCOLUMNS ( _fechas, "@lunes", 'Precios SNP'[Fecha] - WEEKDAY ( 'Precios SNP'[Fecha], 3 ) )
				RETURN
				    SELECTCOLUMNS (
				        _semanas,
				        "Fecha", 'Precios SNP'[Fecha],
				        "Año", YEAR ( [@lunes] + 3 ),
				        "Semana ISO", WEEKNUM ( [@lunes], 21 ),
				        "Año-Semana", YEAR ( [@lunes] + 3 ) & "-" & FORMAT ( WEEKNUM ( [@lunes], 21 ), "00" ),
				        "Semana filtro", IF ( INT ( ( [@lunes] - DATE ( 2018, 1, 1 ) ) / 7 ) = _ultIdx, "Semana actual", YEAR ( [@lunes] + 3 ) & "-" & FORMAT ( WEEKNUM ( [@lunes], 21 ), "00" ) ),
				        "Semana índice", INT ( ( [@lunes] - DATE ( 2018, 1, 1 ) ) / 7 )
				    )

	annotation PBI_Id = b5cdd3a1c16951eca05c309f971dac99

