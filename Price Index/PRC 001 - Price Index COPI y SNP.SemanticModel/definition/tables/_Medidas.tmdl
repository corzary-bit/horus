			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'Precios SNP', 'Precios SNP'[Codigo_PDV], 'Precios SNP'[Fecha] ),
			            "@num", CALCULATE ( IF ( _din, AVERAGE ( 'Precios SNP'[Precio Din KG] ), AVERAGE ( 'Precios SNP'[Precio KG] ) ) )
			        ),
			        REMOVEFILTERS ( Productos ),
			        TREATAS ( _num, 'Precios SNP'[EAN] )
			    )
			-- $/kg del denominador en ese mismo PDV y semana; quedan solo los PDV con los dos precios
			VAR _cruce =
			    FILTER (
			        ADDCOLUMNS (
			            _base,
			            "@den", CALCULATE ( IF ( _din, AVERAGE ( 'Precios SNP'[Precio Din KG] ), AVERAGE ( 'Precios SNP'[Precio KG] ) ), REMOVEFILTERS ( Productos ), TREATAS ( _den, 'Precios SNP'[EAN] ) )
			        ),
			        [@num] > 0 && [@den] > 0
			    )
			RETURN
			    IF ( ISFILTERED ( 'SKU Numerador' ) && ISFILTERED ( 'SKU Denominador' ), MEDIANX ( _cruce, DIVIDE ( [@num], [@den] ) ) )
		formatString: 0.0%
		displayFolder: SNP\Grupo personalizado
		lineageTag: 580366dc-bebf-5b6d-8339-50a594a3e125

	/// PDV distintos que tienen precio del numerador y del denominador en la misma semana.
	measure 'SNP PDV Libre' =
			VAR _num = VALUES ( 'SKU Numerador'[EAN] )
			VAR _den = VALUES ( 'SKU Denominador'[EAN] )
			VAR _din = SELECTEDVALUE ( 'Tipo de precio'[Tipo] ) = "Dinamizado"
			-- $/kg del numerador en cada PDV y semana donde tiene precio
			VAR _base =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'Precios SNP', 'Precios SNP'[Codigo_PDV], 'Precios SNP'[Fecha] ),
			            "@num", CALCULATE ( IF ( _din, AVERAGE ( 'Precios SNP'[Precio Din KG] ), AVERAGE ( 'Precios SNP'[Precio KG] ) ) )
			        ),
			        REMOVEFILTERS ( Productos ),
			        TREATAS ( _num, 'Precios SNP'[EAN] )
			    )
			-- $/kg del denominador en ese mismo PDV y semana; quedan solo los PDV con los dos precios
			VAR _cruce =
			    FILTER (
			        ADDCOLUMNS (
			            _base,
			            "@den", CALCULATE ( IF ( _din, AVERAGE ( 'Precios SNP'[Precio Din KG] ), AVERAGE ( 'Precios SNP'[Precio KG] ) ), REMOVEFILTERS ( Productos ), TREATAS ( _den, 'Precios SNP'[EAN] ) )
			        ),
			        [@num] > 0 && [@den] > 0
			    )
			RETURN
			    IF ( ISFILTERED ( 'SKU Numerador' ) && ISFILTERED ( 'SKU Denominador' ), COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( _cruce, "@pdv", 'Precios SNP'[Codigo_PDV] ) ) ) )
		formatString: #,0
		displayFolder: SNP\Grupo personalizado
		lineageTag: c726fad4-c2df-5a73-8e2e-cf9709bd00d8

	/// Mediana del $/kg del numerador entre los PDV con cruce.
	measure 'SNP Precio KG Num Libre' =
			VAR _num = VALUES ( 'SKU Numerador'[EAN] )
			VAR _den = VALUES ( 'SKU Denominador'[EAN] )
			VAR _din = SELECTEDVALUE ( 'Tipo de precio'[Tipo] ) = "Dinamizado"
