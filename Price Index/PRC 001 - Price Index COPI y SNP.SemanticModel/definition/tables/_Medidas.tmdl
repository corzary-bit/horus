	/// Price Index de la semana calendario anterior. Requiere una sola semana en contexto.
	measure 'COPI PI Par Sem Ant' =
			VAR _sem = SELECTEDVALUE ( 'Semanas COPI'[Semana índice] )
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [COPI PI Par], REMOVEFILTERS ( 'Semanas COPI' ), 'Semanas COPI'[Semana índice] = _sem - 1 )
			    )
		formatString: 0.0%
		displayFolder: COPI\Pares definidos
		lineageTag: d355cb0a-ee5e-53ee-b95e-7a23f6546305

	/// Variación relativa del Price Index contra la semana anterior.
	measure 'COPI Var Par' =
			VAR _ant = [COPI PI Par Sem Ant]
			RETURN
			    IF ( NOT ISBLANK ( _ant ), DIVIDE ( [COPI PI Par] - _ant, _ant ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: COPI\Pares definidos
		lineageTag: 63a841c1-2c70-51e9-aa59-e1391000a0f3

	/// Price Index calculado en el reporte: mediana, entre PDV, del cociente $/kg numerador / $/kg denominador medido en el mismo PDV y la misma semana (fórmula del ETL de Platinum). Con varios SKU de un lado, el precio de ese lado es el promedio de sus $/kg en el PDV.
	measure 'COPI PI Libre' =
			VAR _num = VALUES ( 'SKU Numerador'[EAN] )
			VAR _den = VALUES ( 'SKU Denominador'[EAN] )
			-- $/kg del numerador en cada PDV y semana donde tiene precio
			VAR _base =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'Precios COPI', 'Precios COPI'[Codigo_PDV], 'Precios COPI'[Fecha] ),
			            "@num", CALCULATE ( AVERAGE ( 'Precios COPI'[Precio KG] ) )
			        ),
			        REMOVEFILTERS ( Productos ),
			        TREATAS ( _num, 'Precios COPI'[EAN] )
			    )
			-- $/kg del denominador en ese mismo PDV y semana; quedan solo los PDV con los dos precios
			VAR _cruce =
			    FILTER (
			        ADDCOLUMNS (
			            _base,
			            "@den", CALCULATE ( AVERAGE ( 'Precios COPI'[Precio KG] ), REMOVEFILTERS ( Productos ), TREATAS ( _den, 'Precios COPI'[EAN] ) )
			        ),
			        [@num] > 0 && [@den] > 0
			    )
			RETURN
			    IF ( ISFILTERED ( 'SKU Numerador' ) && ISFILTERED ( 'SKU Denominador' ), MEDIANX ( _cruce, DIVIDE ( [@num], [@den] ) ) )
		formatString: 0.0%
		displayFolder: COPI\Grupo personalizado
		lineageTag: afee7caf-bb54-5669-a066-5bc3dac2a30b

