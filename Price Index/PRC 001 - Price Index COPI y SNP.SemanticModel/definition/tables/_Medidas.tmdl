	/// Price Index de la semana calendario anterior. Requiere una sola semana en contexto.
	measure 'COPI PI Libre Sem Ant' =
			VAR _sem = SELECTEDVALUE ( 'Semanas COPI'[Semana índice] )
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [COPI PI Libre], REMOVEFILTERS ( 'Semanas COPI' ), 'Semanas COPI'[Semana índice] = _sem - 1 )
