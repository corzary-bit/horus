	/// Variación relativa del Price Index contra la semana anterior.
	measure 'COPI Var Libre' =
			VAR _ant = [COPI PI Libre Sem Ant]
			RETURN
			    IF ( NOT ISBLANK ( _ant ), DIVIDE ( [COPI PI Libre] - _ant, _ant ) )
		formatString: +0.0%;-0.0%;0.0%
