	/// Price Index de la semana calendario anterior. Requiere una sola semana en contexto.
	measure 'SNP PI Libre Sem Ant' =
			VAR _sem = SELECTEDVALUE ( 'Semanas SNP'[Semana índice] )
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [SNP PI Libre], REMOVEFILTERS ( 'Semanas SNP' ), 'Semanas SNP'[Semana índice] = _sem - 1 )
			    )
		formatString: 0.0%
		displayFolder: SNP\Grupo personalizado
		lineageTag: 2c85e848-b88b-5cd8-8da9-f41849dce4e2

	/// Variación relativa del Price Index contra la semana anterior.
	measure 'SNP Var Libre' =
			VAR _ant = [SNP PI Libre Sem Ant]
			RETURN
			    IF ( NOT ISBLANK ( _ant ), DIVIDE ( [SNP PI Libre] - _ant, _ant ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: SNP\Grupo personalizado
		lineageTag: 935358ad-f3e6-5b6f-9d82-f34875c94343

	measure 'SNP Datos hasta' =
			VAR _f = CALCULATE ( MAX ( 'Precios SNP'[Fecha] ), REMOVEFILTERS () )
			VAR _sem = CALCULATE ( MAX ( 'Semanas SNP'[Año-Semana] ), REMOVEFILTERS (), 'Semanas SNP'[Fecha] = _f )
			VAR _n = CALCULATE ( COUNTROWS ( 'Precios SNP' ), REMOVEFILTERS () )
			RETURN
			    IF (
			        ISBLANK ( _f ),
			        "Sin datos: actualizar el modelo",
			        "SNP · datos hasta la semana " & _sem & " (" & FORMAT ( _f, "dd/mm/yyyy" ) & ") · " & FORMAT ( _n, "#,0" ) & " precios"
			    )
		displayFolder: SNP
		lineageTag: 50b32c4e-d004-5875-9570-aa553b0241d7

	measure 'Texto SKU A' =
			VAR _n = COUNTROWS ( VALUES ( 'SKU Numerador'[EAN] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISFILTERED ( 'SKU Numerador' ), "(elegir SKU A)",
			        _n = 1, SELECTEDVALUE ( 'SKU Numerador'[SKU] ),
			        _n & " SKUs (promedio)"
			    )
		displayFolder: Textos
		lineageTag: e714f9fa-403b-5670-9d76-3c330d7d7c44

	measure 'Texto SKU B' =
			VAR _n = COUNTROWS ( VALUES ( 'SKU Denominador'[EAN] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISFILTERED ( 'SKU Denominador' ), "(elegir SKU B)",
			        _n = 1, SELECTEDVALUE ( 'SKU Denominador'[SKU] ),
			        _n & " SKUs (promedio)"
			    )
		displayFolder: Textos
		lineageTag: 66fccb1d-0ead-5696-aa26-7fc66d1a3f57

	measure 'Texto comparación' = "Numerador (SKU A): " & [Texto SKU A] & "     vs     Denominador (SKU B): " & [Texto SKU B]
		displayFolder: Textos
		lineageTag: 0f639d92-e4da-5d8d-a094-8c92ceef6664

