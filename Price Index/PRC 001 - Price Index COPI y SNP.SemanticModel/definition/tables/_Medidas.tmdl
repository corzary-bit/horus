		lineageTag: f41762e0-14f4-52ca-b9e9-cd959adaa664

	measure 'COPI Datos hasta' =
			VAR _f = CALCULATE ( MAX ( 'Precios COPI'[Fecha] ), REMOVEFILTERS () )
			VAR _sem = CALCULATE ( MAX ( 'Semanas COPI'[Año-Semana] ), REMOVEFILTERS (), 'Semanas COPI'[Fecha] = _f )
			VAR _n = CALCULATE ( COUNTROWS ( 'Precios COPI' ), REMOVEFILTERS () )
			RETURN
			    IF (
			        ISBLANK ( _f ),
			        "Sin datos: actualizar el modelo",
			        "COPI · datos hasta la semana " & _sem & " (" & FORMAT ( _f, "dd/mm/yyyy" ) & ") · " & FORMAT ( _n, "#,0" ) & " precios"
			    )
		displayFolder: COPI
		lineageTag: 32beae00-8333-5a21-96ad-b543c85fc88f

	/// Price Index calculado en el reporte: mediana, entre PDV, del cociente $/kg numerador / $/kg denominador medido en el mismo PDV y la misma semana (fórmula del ETL de Platinum). Solo con un par en contexto; con varios pares queda vacío.
	measure 'SNP PI Par' =
			VAR _num = VALUES ( 'Pares SNP'[EAN_Numerador] )
			VAR _den = VALUES ( 'Pares SNP'[EAN_Denominador] )
			VAR _din = SELECTEDVALUE ( 'Tipo de precio'[Tipo] ) = "Dinamizado"
			-- $/kg del numerador en cada PDV y semana donde tiene precio
			VAR _base =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'Precios SNP', 'Precios SNP'[Codigo_PDV], 'Precios SNP'[Fecha] ),
			            "@num", CALCULATE ( IF ( _din, AVERAGE ( 'Precios SNP'[Precio Din KG] ), AVERAGE ( 'Precios SNP'[Precio KG] ) ) )
			        ),
			        REMOVEFILTERS ( Productos ),
			        TREATAS ( _num, 'Precios SNP'[EAN] )
			    )
			-- $/kg del denominador en ese mismo PDV y semana; quedan solo los PDV con los dos precios
			VAR _cruce =
			    FILTER (
			        ADDCOLUMNS (
			            _base,
			            "@den", CALCULATE ( IF ( _din, AVERAGE ( 'Precios SNP'[Precio Din KG] ), AVERAGE ( 'Precios SNP'[Precio KG] ) ), REMOVEFILTERS ( Productos ), TREATAS ( _den, 'Precios SNP'[EAN] ) )
			        ),
			        [@num] > 0 && [@den] > 0
			    )
			RETURN
			    IF ( COUNTROWS ( _num ) = 1 && COUNTROWS ( _den ) = 1, MEDIANX ( _cruce, DIVIDE ( [@num], [@den] ) ) )
		formatString: 0.0%
		displayFolder: SNP\Pares definidos
		lineageTag: 92f00a2d-d03f-5c80-84ba-5774f87adc5e

