table _Medidas
	lineageTag: 0a10ca73-90a4-534b-9ff4-6b1e09499f62

	/// Price Index calculado en el reporte: mediana, entre PDV, del cociente $/kg numerador / $/kg denominador medido en el mismo PDV y la misma semana (fórmula del ETL de Platinum). Solo con un par en contexto; con varios pares queda vacío.
	measure 'COPI PI Par' =
			VAR _num = VALUES ( 'Pares COPI'[EAN_Numerador] )
			VAR _den = VALUES ( 'Pares COPI'[EAN_Denominador] )
			-- $/kg del numerador en cada PDV y semana donde tiene precio
			VAR _base =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'Precios COPI', 'Precios COPI'[Codigo_PDV], 'Precios COPI'[Fecha] ),
			            "@num", CALCULATE ( AVERAGE ( 'Precios COPI'[Precio KG] ) )
			        ),
			        REMOVEFILTERS ( Productos ),
			        TREATAS ( _num, 'Precios COPI'[EAN] )
			    )
			-- $/kg del denominador en ese mismo PDV y semana; quedan solo los PDV con los dos precios
			VAR _cruce =
			    FILTER (
			        ADDCOLUMNS (
			            _base,
			            "@den", CALCULATE ( AVERAGE ( 'Precios COPI'[Precio KG] ), REMOVEFILTERS ( Productos ), TREATAS ( _den, 'Precios COPI'[EAN] ) )
			        ),
			        [@num] > 0 && [@den] > 0
			    )
			RETURN
			    IF ( COUNTROWS ( _num ) = 1 && COUNTROWS ( _den ) = 1, MEDIANX ( _cruce, DIVIDE ( [@num], [@den] ) ) )
		formatString: 0.0%
		displayFolder: COPI\Pares definidos
		lineageTag: 12aeed12-f9ce-5888-a785-52e41f4bb457

	/// PDV distintos que tienen precio del numerador y del denominador en la misma semana.
	measure 'COPI PDV Par' =
			VAR _num = VALUES ( 'Pares COPI'[EAN_Numerador] )
			VAR _den = VALUES ( 'Pares COPI'[EAN_Denominador] )
			-- $/kg del numerador en cada PDV y semana donde tiene precio
			VAR _base =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'Precios COPI', 'Precios COPI'[Codigo_PDV], 'Precios COPI'[Fecha] ),
			            "@num", CALCULATE ( AVERAGE ( 'Precios COPI'[Precio KG] ) )
			        ),
			        REMOVEFILTERS ( Productos ),
			        TREATAS ( _num, 'Precios COPI'[EAN] )
			    )
			-- $/kg del denominador en ese mismo PDV y semana; quedan solo los PDV con los dos precios
			VAR _cruce =
			    FILTER (
			        ADDCOLUMNS (
			            _base,
			            "@den", CALCULATE ( AVERAGE ( 'Precios COPI'[Precio KG] ), REMOVEFILTERS ( Productos ), TREATAS ( _den, 'Precios COPI'[EAN] ) )
			        ),
			        [@num] > 0 && [@den] > 0
			    )
			RETURN
			    IF ( COUNTROWS ( _num ) = 1 && COUNTROWS ( _den ) = 1, COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( _cruce, "@pdv", 'Precios COPI'[Codigo_PDV] ) ) ) )
		formatString: #,0
		displayFolder: COPI\Pares definidos
		lineageTag: 6c82c805-d025-518d-919e-f7d2fd8847b5

	/// Mediana del $/kg del numerador entre los PDV con cruce.
	measure 'COPI Precio KG Num Par' =
			VAR _num = VALUES ( 'Pares COPI'[EAN_Numerador] )
