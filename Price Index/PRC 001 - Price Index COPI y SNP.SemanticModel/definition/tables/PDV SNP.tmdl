	partition 'PDV SNP' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("10.1.82.27", "SANDBOX_BRONZE"),
				    Gold = Origen{[Schema="PRC",Item="Gold_Comparativo"]}[Data],
				    Filas = Table.SelectRows(Gold, each [Fuente] = "SNP" and [Codigo_PDV] <> null),
				    PDV = Table.Group(Filas, {"Codigo_PDV"}, {{"Nombre PDV", each List.Max([Nombre_PDV]), type nullable text}, {"Cadena", each List.Max([Descripcion_Cliente]), type nullable text}, {"Subcanal", each List.Max([Subcanal]), type nullable text}, {"Provincia", each List.Max([Provincia]), type nullable text}, {"Región", each List.Max([Region]), type nullable text}}),
				    Tipos = Table.TransformColumnTypes(PDV, {{"Codigo_PDV", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table

