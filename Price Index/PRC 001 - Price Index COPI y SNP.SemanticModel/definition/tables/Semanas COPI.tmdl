	column 'Semana filtro'
		dataType: string
		lineageTag: 10021268-9fc1-55ad-8e06-511fb2adec8a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Semana filtro]
		sortByColumn: 'Semana índice'

		annotation SummarizationSetBy = Automatic

	column 'Semana índice'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b9bceb9f-ea6f-52e7-aaa3-082b3a999e2f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Semana índice]

		annotation SummarizationSetBy = Automatic

	partition 'Semanas COPI' = calculated
		mode: import
		source =
				-- Una fila por semana relevada en COPI (Fecha = lunes, normalizado en silver).
				-- "Semana filtro" llama "Semana actual" a la última semana con datos de esta fuente.
				VAR _fechas = FILTER ( DISTINCT ( 'Precios COPI'[Fecha] ), NOT ISBLANK ( 'Precios COPI'[Fecha] ) )
				VAR _ult = MAXX ( _fechas, 'Precios COPI'[Fecha] )
				VAR _ultIdx = INT ( ( _ult - WEEKDAY ( _ult, 3 ) - DATE ( 2018, 1, 1 ) ) / 7 )
				VAR _semanas = ADDCOLUMNS ( _fechas, "@lunes", 'Precios COPI'[Fecha] - WEEKDAY ( 'Precios COPI'[Fecha], 3 ) )
				RETURN
				    SELECTCOLUMNS (
				        _semanas,
				        "Fecha", 'Precios COPI'[Fecha],
				        "Año", YEAR ( [@lunes] + 3 ),
				        "Semana ISO", WEEKNUM ( [@lunes], 21 ),
				        "Año-Semana", YEAR ( [@lunes] + 3 ) & "-" & FORMAT ( WEEKNUM ( [@lunes], 21 ), "00" ),
				        "Semana filtro", IF ( INT ( ( [@lunes] - DATE ( 2018, 1, 1 ) ) / 7 ) = _ultIdx, "Semana actual", YEAR ( [@lunes] + 3 ) & "-" & FORMAT ( WEEKNUM ( [@lunes], 21 ), "00" ) ),
				        "Semana índice", INT ( ( [@lunes] - DATE ( 2018, 1, 1 ) ) / 7 )
				    )

	annotation PBI_Id = 5ee7afe63e79540a9f5b28e46a7b2670

