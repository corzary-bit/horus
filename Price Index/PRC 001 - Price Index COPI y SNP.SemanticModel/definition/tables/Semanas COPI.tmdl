table 'Semanas COPI'
	lineageTag: ce678edb-af55-5f2e-9df5-a4ae2e5c2210

	column Fecha
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: ecd839a6-f0b3-5972-8f03-78442c1a1de7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fecha]

		annotation SummarizationSetBy = Automatic

	column Año
		dataType: int64
		formatString: 0
		lineageTag: b37f619c-62e9-5381-bf5c-86436f043534
		summarizeBy: none
		isNameInferred
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column 'Semana ISO'
		dataType: int64
		formatString: 0
		lineageTag: 44e29f09-2305-5203-b749-f8cd14874aac
		summarizeBy: none
		isNameInferred
		sourceColumn: [Semana ISO]

