	partition Productos = m
		mode: import
		source =
				let
				    Origen = Sql.Database("10.1.82.27\mfgbi", "MDS_PRODU"),
				    Maestro = Origen{[Schema="mdm",Item="ICO_EANs_mercado"]}[Data],
				    Columnas = Table.SelectColumns(Maestro, {"EAN", "KG / U", "Familia", "Empresa", "Marca", "Segmento", "Cód SKU Marfrig", "Descripción SKU Nuevo", "Marca Propia_Name"}),
				    Nombres = Table.RenameColumns(Columnas, {{"KG / U", "KG_U"}, {"Cód SKU Marfrig", "Cod_SKU"}, {"Descripción SKU Nuevo", "Descripcion_SKU"}, {"Marca Propia_Name", "Marca_Propia"}}),
				    Valores = Table.TransformColumns(Nombres, {{"EAN", each Text.Trim(Text.From(_)), type nullable text}, {"KG_U", each try Number.From(_, "en-US") otherwise null, type nullable number}, {"Cod_SKU", each Text.From(_), type nullable text}, {"Descripcion_SKU", each Text.From(_), type nullable text}, {"Marca", each Text.From(_), type nullable text}, {"Empresa", each Text.From(_), type nullable text}, {"Familia", each Text.From(_), type nullable text}, {"Segmento", each Text.From(_), type nullable text}, {"Marca_Propia", each Text.From(_), type nullable text}}),
				    ConEAN = Table.SelectRows(Valores, each [EAN] <> null and [EAN] <> ""),
				    Unicos = Table.Distinct(ConEAN, {"EAN"}),
				    SKU = Table.AddColumn(Unicos, "SKU", each (if [Descripcion_SKU] = null then "Sin descripción" else [Descripcion_SKU]) & " (" & [EAN] & ")", type text)
				in
				    SKU

	annotation PBI_ResultType = Table

