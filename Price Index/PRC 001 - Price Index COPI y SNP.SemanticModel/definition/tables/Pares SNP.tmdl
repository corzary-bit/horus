				    Valores = Table.TransformColumns(Columnas, {{"Clave", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}, {"Canal", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}, {"Agrupador", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}, {"EAN_Numerador", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}, {"Desc_Numerador", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}, {"EAN_Denominador", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}, {"Desc_Denominador", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}}),
				    Par = Table.AddColumn(Valores, "Par", each (if [Desc_Numerador] = null then [EAN_Numerador] else [Desc_Numerador]) & " vs " & (if [Desc_Denominador] = null then [EAN_Denominador] else [Desc_Denominador]), type text)
				in
