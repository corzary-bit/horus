	partition 'Pares SNP' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("10.1.82.27", "SANDBOX_BRONZE"),
				    Pares = Origen{[Schema="PRC",Item="platinum_pairs_snp"]}[Data],
