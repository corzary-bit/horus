	partition 'PDV COPI' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("10.1.82.27", "SANDBOX_BRONZE"),
				    Gold = Origen{[Schema="PRC",Item="Gold_Comparativo"]}[Data],
				    Filas = Table.SelectRows(Gold, each [Fuente] = "COPI" and [Codigo_PDV] <> null),
				    PDV = Table.Group(Filas, {"Codigo_PDV"}, {{"Nombre PDV", each List.Max([Nombre_PDV]), type nullable text}, {"Región", each List.Max([Region]), type nullable text}, {"Provincia", each List.Max([Provincia]), type nullable text}, {"Localidad", each List.Max([Localidad]), type nullable text}, {"Subcanal", each List.Max([Subcanal]), type nullable text}, {"Clúster", each List.Max([Cluster_Para]), type nullable text}}),
				    Tipos = Table.TransformColumnTypes(PDV, {{"Codigo_PDV", type text}})
				in
