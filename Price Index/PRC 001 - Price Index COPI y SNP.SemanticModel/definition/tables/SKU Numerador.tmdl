	partition 'SKU Numerador' = calculated
		mode: import
		source =
				-- Lista de SKUs para elegir el numerador. Sin relaciones: las medidas leen la selección.
				-- Solo SKUs con precio en alguna fuente y con KG / U en el maestro (sin KG / U no hay $/kg).
				VAR _conPrecio = DISTINCT ( UNION ( DISTINCT ( 'Precios COPI'[EAN] ), DISTINCT ( 'Precios SNP'[EAN] ) ) )
				RETURN
				    SELECTCOLUMNS (
				        FILTER ( Productos, Productos[KG_U] > 0 && Productos[EAN] IN _conPrecio ),
				        "EAN", Productos[EAN],
				        "SKU", Productos[SKU],
				        "Marca", Productos[Marca],
				        "Empresa", Productos[Empresa],
				        "Familia", Productos[Familia],
				        "Segmento", Productos[Segmento]
				    )

	annotation PBI_Id = d0ccaf87d24059b881b452a9c7cc7436

